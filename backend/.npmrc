registry=https://registry.npmmirror.com
disturl=https://npmmirror.com/dist
electron_mirror=https://npmmirror.com/mirrors/electron/
sass_binary_site=https://npmmirror.com/mirrors/node-sass
phantomjs_cdnurl=https://npmmirror.com/mirrors/phantomjs
chromedriver_cdnurl=https://npmmirror.com/mirrors/chromedriver
python_mirror=https://npmmirror.com/mirrors/python
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# sharp 0.33+ 的 @img/sharp-* 预编译包从 npm 官方拉取
@img:registry=https://registry.npmjs.org/

# pnpm 必须 hoist sharp，否则 require('sharp') 找不到 @img/sharp-linux-x64（见 sharp 官方 pnpm 文档）
public-hoist-pattern[]=*sharp*
public-hoist-pattern[]=*libvips*
public-hoist-pattern[]=@img/*
