{
  "name": "tanva-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node -r ./dist/tracing.bootstrap.js dist/main.js",
    "prisma:generate": "node scripts/ensure-prisma-client.js",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');const p='dist/ai/workers/background-removal.worker.js';if(!fs.existsSync(p)){console.error('Missing worker:',p);process.exit(1)}console.log('background-removal worker ok')\"",
    "postinstall": "node scripts/postinstall-native-deps.js",
    "diagnose:sharp": "node scripts/diagnose-sharp.js",
    "diagnose:bg-removal": "node scripts/diagnose-background-removal.js",
    "fix:sharp": "node scripts/fix-sharp-install.js",
    "fix:onnx": "node scripts/fix-onnxruntime-install.js",
    "verify:native": "node scripts/diagnose-sharp.js && node scripts/diagnose-background-removal.js",
    "dev": "ts-node-dev --respawn --transpile-only -r ./src/tracing.bootstrap.ts src/main.ts",
    "lint": "echo 'no lint configured'",
    "sanitize:design-json": "ts-node scripts/sanitize-design-json.ts",
    "backfill:global-video-history": "ts-node scripts/backfill-global-video-history.ts",
    "restore:tos-archived": "ts-node scripts/restore-tos-archived-objects.ts"
  },
  "dependencies": {
    "@alicloud/green20220302": "^3.2.4",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/sms-sdk": "^1.1.6",
    "@alicloud/tea-util": "^1.4.11",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@fastify/compress": "^6.5.0",
    "@fastify/cookie": "^8.0.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^10.0.0",
    "@fastify/multipart": "^7.0.0",
    "@google/genai": "^1.1.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/websockets": "^10.4.22",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^5.18.0",
    "@types/qrcode": "^1.5.6",
    "ali-oss": "^6.20.0",
    "alipay-sdk": "^4.14.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie": "^0.6.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "5.6.2",
    "ioredis": "^5.8.2",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "onnxruntime-node": "1.17.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socks-proxy-agent": "^8.0.5",
    "wechatpay-node-v3": "^2.2.1",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-linuxmusl-x64": "0.34.5",
    "@img/sharp-wasm32": "0.34.5"
  },
  "overrides": {
    "onnxruntime-node": "1.17.3",
    "@imgly/background-removal-node": {
      "sharp": "$sharp",
      "onnxruntime-node": "1.17.3"
    }
  },
  "pnpm": {
    "overrides": {
      "@imgly/background-removal-node>sharp": "$sharp",
      "onnxruntime-node": "1.17.3",
      "@imgly/background-removal-node>onnxruntime-node": "1.17.3"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "onnxruntime-node",
      "@prisma/client",
      "prisma"
    ]
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/passport-jwt": "^3.0.13",
    "@types/ws": "^8.18.1",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.8.3",
    "undici": "^7.16.0"
  }
}
