# ===== 对话主模型（W1-① 连通验证需要）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# ===== 服务 =====
PORT=8712

# ===== 千问生图（测试后端：TASK_SOURCE=qianwen 时启用，真实出图联调）=====
# 文档: https://platform.qianwenai.com/docs/developer-guides/image-generation/text-to-image
QIANWEN_API_KEY=
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QIANWEN_IMAGE_MODEL=wan2.7-image

# ===== 天宫TAI 后端（TASK_SOURCE=tai 时启用，对接 TAI 仓库 backend，全局前缀 /api）=====
# TAI 后端根地址（不含 /api），本地开发默认 http://localhost:4000
TAI_API_BASE_URL=http://localhost:4000
# TAI 后端 x-api-key（走 ApiKeyOrJwtGuard；留空则 tai 源不可用）
TAI_API_TOKEN=
# 生图 provider：gemini-pro | banana | banana-2.5 | banana-3.1 | runninghub | midjourney | nano2 | seedream5 | seedream5Pro
# 留空默认 banana-3.1：唯一同时保住 aspectRatio 与图生图（edit-image-async）的 provider
# ⚠️ 勿改用 seedream5 / seedream5Pro：已核对 TAI 源码（seedream5.provider.ts:91），
#    其 editImage() 直接 throw，且 aspectRatio 被 provider 丢弃 → 版本迭代会静默退化为文生图
TAI_IMAGE_PROVIDER=banana-3.1
# 生图模型 ID 覆盖（可选，留空用 provider 默认）
TAI_IMAGE_MODEL=
# 视频 provider：kling | kling-2.6 | kling-o3 | vidu | viduq3-pro | doubao | omni-flash-ext
# kling-o3 支持首尾帧插值（对应 generate_video.lastFrameAssetId 路由目标）
TAI_VIDEO_PROVIDER=kling-o3

# 任务源选择：mock | tai | qianwen
# mock=SVG 占位图（零配置起步，推荐首次运行用这个）；
# qianwen=千问生图真实出图（视频仍走 mock 占位）；
# tai=TAI 后端真实任务（生图+视频）——**对接 TAI 平台时必须设为 tai**
# 注：代码层默认 mock（src/config.ts），此处仅作模板值
TASK_SOURCE=qianwen
